     "Input bandwidth": 0.5,
     "Dry signal level (dB)": -2.0,
     "Early reflection level (dB)": -14.0,
     "Tail level (dB)": -16.0
    }
   }
  ]
 },
 {
  "id": "robot",
  "name": "Robot",
