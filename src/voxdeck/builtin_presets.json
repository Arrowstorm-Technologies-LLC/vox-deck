[
 {
  "id": "clean",
  "name": "Clean",
  "description": "Dry microphone, no effects",
  "chain": []
 },
 {
  "id": "denoise",
  "name": "Denoise",
  "description": "RNNoise noise suppression (classic DSP network, CPU only)",
  "chain": [
   {
    "type": "ladspa",
    "plugin": "librnnoise_ladspa",
    "label": "noise_suppressor_mono",
    "control": {
     "VAD Threshold (%)": 50.0,
     "VAD Grace Period (ms)": 200.0,
     "Retroactive VAD Grace (ms)": 0.0
    }
   }
  ]
 },
 {
  "id": "deep",
  "name": "Deep",
  "description": "Lower pitch",
  "chain": [
   {
    "type": "ladspa",
    "plugin": "pitch_scale_1194",
    "label": "pitchScaleHQ",
    "control": {
     "Pitch co-efficient": 0.75
    }
   }
  ]
 },
 {
  "id": "chipmunk",
  "name": "Chipmunk",
  "description": "Higher pitch",
  "chain": [
   {
    "type": "ladspa",
    "plugin": "pitch_scale_1194",
    "label": "pitchScaleHQ",
    "control": {
     "Pitch co-efficient": 1.6
    }
   }
  ]
 },
 {
  "id": "demon",
  "name": "Demon",
  "description": "Very low, gritty, with a hall",
  "chain": [
   {
    "type": "ladspa",
    "plugin": "pitch_scale_1194",
    "label": "pitchScaleHQ",
    "control": {
     "Pitch co-efficient": 0.55
    }
   },
   {
    "type": "ladspa",
