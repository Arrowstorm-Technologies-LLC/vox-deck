[
 {"id": "clean", "name": "Clean", "description": "Dry microphone, no effects", "chain": []},
 {
  "id": "denoise",
  "name": "Denoise",
  "description": "RNNoise noise suppression (classic DSP network, CPU only)",
  "chain": [
   {
    "type": "ladspa",
    "plugin": "librnnoise_ladspa",
    "label": "noise_suppressor_mono",
    "control": {
     "VAD Threshold (%)": 50.0,
     "VAD Grace Period (ms)": 200.0,
     "Retroactive VAD Grace (ms)": 0.0,
     "Dry Mix": 0.0
    }
   }
  ],
  "tune": [
   {"id": "threshold", "name": "Voice threshold", "node": 0, "control": "VAD Threshold (%)", "min": 0, "max": 99, "step": 1, "unit": "%"},
   {"id": "keep", "name": "Original kept", "node": 0, "control": "Dry Mix", "min": 0, "max": 100, "step": 1, "unit": "%", "scale": "pct"}
  ]
 },
 {
